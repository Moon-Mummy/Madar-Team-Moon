; Luna-Quest-V1 — Godot 4.3 project
; Open this folder with the Godot editor (Project Manager -> Import -> project.godot) and press F5.

config_version=5

[application]

config/name="Luna-Quest-V1"
config/description="A walkable Moon base on the Shackleton rim. Daily tasks spend your own energy; the base's electricity is a separate budget."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

